generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["campus_schema"]
}

model University {
  id        String     @id @default("ECI")
  name      String     @default("Escuela Colombiana de Ingeniería Julio Garavito")
  buildings Building[]

  @@map("universities")
  @@schema("campus_schema")
}

model Faculty {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  hexColor  String   @default("#8B0000") @map("hex_color")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faculties")
  @@schema("campus_schema")
}

model Building {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  svgElementId    String          @unique @map("svg_element_id")
  imageUrl        String?         @map("image_url")
  floorsCount     Int             @default(1) @map("floors_count")
  academicInfo    String?         @map("academic_info")
  isActive        Boolean         @default(true) @map("is_active")
  universityId    String          @default("ECI") @map("university_id")
  university      University      @relation(fields: [universityId], references: [id])
  places          CampusPlace[]
  services        CampusService[]

  @@map("buildings")
  @@schema("campus_schema")
}

model CampusPlace {
  id                  String   @id @default(uuid())
  buildingId          String   @map("building_id")
  name                String
  floor               String
  maxPhysicalCapacity Int      @default(30) @map("max_physical_capacity")
  isActive            Boolean  @default(true) @map("is_active")
  building            Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@map("campus_places")
  @@schema("campus_schema")
}

model SportsFacility {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  sportTypes   String[] @map("sport_types")
  svgElementId String   @unique @map("svg_element_id")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("sports_facilities")
  @@schema("campus_schema")
}

enum ServiceType {
  RESTAURANTE
  CAFETERIA
  BIBLIOTECA
  ENFERMERIA
  FOTOCOPIAS
  PARQUEADERO
  OFICINA

  @@schema("campus_schema")
}

model CampusService {
  id             String      @id @default(uuid())
  name           String
  serviceType    ServiceType @map("service_type")
  operatingHours String?     @map("operating_hours")
  phone          String?
  buildingId     String      @map("building_id")
  building       Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@map("campus_services")
  @@schema("campus_schema")
}
